\begin{longtable}{| p{3.5cm} | p{11.5cm} |}
    \caption{Đặc tả Use Case: Đăng ký gói tập}
    \label{tab:usecase_register_package} \\
    \hline
    \textbf{Thuộc tính} & \textbf{Chi tiết} \\
    \hline
    \endfirsthead
    
    \hline
    \textbf{Thuộc tính} & \textbf{Chi tiết} \\
    \hline
    \endhead
    
    \textbf{Tên ca sử dụng} & Đăng ký gói tập \\
    \hline
    \textbf{Tác nhân} & Hội viên (Member), Lễ tân / Quản trị viên (Admin) \\
    \hline
    \textbf{Mô tả} & Cho phép Hội viên (tự thao tác online) hoặc Lễ tân (thao tác hộ tại quầy) chọn mua các gói dịch vụ tập luyện của phòng tập (ví dụ: Gói 1 tháng, Gói 1 năm, Gói VIP) để bắt đầu sử dụng dịch vụ. \\
    \hline
    \textbf{Tiền điều kiện} & 
    -- Hệ thống đang hoạt động và đã cấu hình sẵn danh sách các gói tập kèm giá bán. \newline
    -- Hội viên phải có tài khoản trên hệ thống (đã đăng nhập). \\
    \hline
    \textbf{Luồng chính} & 
    1. Người dùng truy cập vào trang ``Danh sách gói tập'' hoặc ``Bảng giá''. \newline
    2. Hệ thống hiển thị các gói tập hiện có cùng với thông tin chi tiết (tên gói, mức giá, thời hạn, các quyền lợi đi kèm). \newline
    3. Người dùng chọn một gói tập phù hợp và nhấn nút ``Đăng ký'' hoặc ``Mua ngay''. \newline
    4. Hệ thống hiển thị giao diện xác nhận thông tin đơn hàng, cho phép người dùng nhập mã giảm giá (nếu có). \newline
    5. Người dùng kiểm tra lại thông tin và nhấn nút ``Tiến hành thanh toán''. \newline
    6. Hệ thống tự động tạo một Hóa đơn (Invoice) với trạng thái ``Chờ thanh toán'' và chuyển hướng người dùng sang giao diện của ca sử dụng ``Thanh toán''. \newline
    7. Sau khi quá trình thanh toán hoàn tất thành công, hệ thống tiếp nhận phản hồi giao dịch. \newline
    8. Hệ thống kích hoạt gói tập cho Hội viên (cập nhật ngày bắt đầu và ngày hết hạn) và gửi email/thông báo xác nhận đăng ký thành công. \\
    \hline
    \textbf{Luồng thay thế} & 
    \textbf{4a. Mã giảm giá sai/hết hạn:} Nếu mã khuyến mãi không hợp lệ, hệ thống sẽ báo lỗi màu đỏ ``Mã giảm giá không hợp lệ hoặc đã hết hạn'' và không áp dụng mức giảm. \newline
    \textbf{5a. Hủy đăng ký giữa chừng:} Nếu người dùng nhấn ``Trở lại'' hoặc thoát trang xác nhận, hệ thống sẽ hủy bỏ phiên làm việc và không tạo hóa đơn. \newline
    \textbf{7a. Thanh toán thất bại:} Nếu quá trình ở ca sử dụng Thanh toán không thành công, gói tập sẽ không được kích hoạt. Hóa đơn vẫn được lưu trong mục ``Lịch sử giao dịch'' với trạng thái ``Chờ thanh toán'' để Hội viên có thể thanh toán lại sau. \\
    \hline
    \textbf{Hậu điều kiện} & 
    -- \textbf{Thành công:} Gói tập được thêm/kích hoạt vào tài khoản của Hội viên. Hóa đơn được ghi nhận là Đã thanh toán. \newline
    -- \textbf{Thất bại:} Quyền lợi của Hội viên không thay đổi, gói tập chưa có hiệu lực. \\
    \hline
    \textbf{Mở rộng} & 
    -- \textbf{Cộng dồn thời gian (Gia hạn):} Nếu Hội viên đang sử dụng một gói tập vẫn còn hạn (ví dụ còn 10 ngày) và mua tiếp gói tập mới, hệ thống sẽ tự động cộng dồn thời gian của gói mới nối tiếp vào ngày hết hạn hiện tại, giúp Hội viên không bị mất ngày sử dụng. \\
    \hline
\end{longtable}
